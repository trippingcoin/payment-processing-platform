APP_PORT=8080
APP_VERSION=v0.1.0
ENV=development
INTERNAL_TOKEN=local-development-token
SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_PORT=55432
DB_DSN=postgres://payments:payments@localhost:55432/payments?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MIN_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092
KAFKA_PAYMENTS_TOPIC=payments.events.v1
OUTBOX_POLL_INTERVAL=1s
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m

FRAUD_POSTGRES_DB=fraud
FRAUD_POSTGRES_USER=fraud
FRAUD_POSTGRES_PASSWORD=fraud
FRAUD_POSTGRES_PORT=55433
FRAUD_DB_DSN=postgres://fraud:fraud@localhost:55433/fraud?sslmode=disable
KAFKA_FRAUD_TOPIC=fraud.events.v1
FRAUD_CONSUMER_GROUP=fraud-service-v1
FRAUD_MAX_AMOUNT_MINOR=1000000
FRAUD_CURRENCY=KZT
FRAUD_PROCESS_TIMEOUT=10s
